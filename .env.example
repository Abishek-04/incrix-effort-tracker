# ---- AWS DynamoDB ----
# Local development can use the standard names:
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=incrix-effort-tracker

# On Vercel, AWS_* names are reserved — set these instead (they take precedence):
# APP_AWS_REGION=ap-south-1
# APP_AWS_ACCESS_KEY_ID=
# APP_AWS_SECRET_ACCESS_KEY=

# ---- Sign-in ----
# Long random string (32+ chars) used to sign session tokens. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=
